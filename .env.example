# --- MAX ---
MAX_BOT_TOKEN=
# Публичный https-адрес сервера (для мини-приложения, Robokassa, callback Suno)
PUBLIC_URL=https://example.com
# Обязательные каналы для подписки: "chatId|https://max.ru/join/..." через запятую (пусто = без проверки)
REQUIRED_CHANNELS=
# Ссылка на мини-приложение (https://max.ru/<bot>?startapp) — для кнопки «Открыть приложение»
MINIAPP_URL=

# --- Тексты песен (Claude) ---
ANTHROPIC_API_KEY=
LYRICS_MODEL=claude-sonnet-5-5

# --- Музыка (Suno через агрегатор, формат sunoapi.org) ---
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_API_KEY=
SUNO_MODEL=V4_5

# --- Robokassa ---
ROBOKASSA_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_TEST=1

# --- Прочее ---
PORT=3000
DB_PATH=./data/app.db
# 1 = разрешить X-Dev-User вместо подписи initData (только локально!)
DEV_AUTH=0
# user_id администраторов через запятую (команда /grant <user_id> <tokens>)
ADMIN_IDS=
